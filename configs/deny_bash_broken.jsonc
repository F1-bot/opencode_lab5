// ══════════════════════════════════════════════════════════════════
// ПАСТКА. Цей конфіг виглядає правильним і НЕ ДІЄ.
//
// Він валідний за схемою, не дає ні помилки, ні попередження. Але
// дії "bash" в OpenCode 2.x немає — правило ні з чим не збігається і
// просто нічого не робить. Тихо.
//
// Це найнебезпечніший клас помилки в конфігурації: не падіння, а
// хибне відчуття захищеності. Конфіг у репозиторії, рев'ю пройдено,
// усі спокійні — а оболонка в агента на місці.
//
// Перевірка: python probe.py --config configs/deny_bash_broken.jsonc
// Проба відповість YES — тобто оболонка нікуди не поділася.
//
// Правильні імена дій не вгадують, а дивляться:
//     opencode debug agents
//
// API-КЛЮЧІ: не потрібні.
// ══════════════════════════════════════════════════════════════════
{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",

  "permissions": [
    { "action": "bash", "resource": "*", "effect": "deny" }
  ]
}
