// ══════════════════════════════════════════════════════════════════
// Ваш MCP-сервер із ЛАБОРАТОРНОЇ 4 всередині чужого агента.
//
// У ЛР4 ви писали СЕРВЕР і перевіряли його Inspector'ом та Claude
// Desktop. OpenCode — ще один КЛІЄНТ, написаний іншими людьми, іншою
// мовою, без жодного уявлення про ваш код. Якщо він підхопить ваш
// сервер — межею між ними є протокол, а не спільна бібліотека.
//
// ТРИ МІСЦЯ, ДЕ СПОТИКАЮТЬСЯ
//   · у 2.x сервери лежать під mcp.servers.<ім'я>; у 1.x було просто
//     mcp.<ім'я> — старий приклад мовчки не спрацює;
//   · "type" буває лише "local" або "remote"; значення "stdio" НЕ
//     ІСНУЄ, хоч його пишуть у половині прикладів в інтернеті;
//   · "command" — ОДИН масив: файл і аргументи разом. Окремого "args"
//     немає, змінні оточення задають через "environment".
//
// НЕ пишіть {env:VAR} усередині command — запуск зависає.
//
// Перевірка:
//     opencode mcp list          -> спершу "pending", це нормально:
//                                   сервер стартує при першій сесії
//     opencode run --auto "Using the store MCP server, how many
//                          products are there? One number only."
//     opencode mcp list          -> тепер "connected"
//
// API-КЛЮЧІ: не потрібні.
// ══════════════════════════════════════════════════════════════════
{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",

  "mcp": {
    "servers": {
      "store": {
        "type": "local",
        "command": [
          // ← ВАШ Python із venv ЛР4, абсолютним шляхом
          "G:/Лекція 2 ШІтаГМ/lb4/mcp_sample/.venv/Scripts/python.exe",
          // ← шлях до server.py рахується від теки з opencode.jsonc
          "G:/Лекція 2 ШІтаГМ/lb4/mcp_sample/server.py"
        ]
      }
    }
  },

  // Дозволи поширюються і на MCP-інструменти. Звуться вони
  // <сервер>_<інструмент>, тож закрити запис, лишивши читання, можна
  // так. Перевіряйте пробою: попросіть агента створити замовлення.
  "permissions": [
    { "action": "store_create_order",    "resource": "*", "effect": "deny" },
    { "action": "store_add_product",     "resource": "*", "effect": "deny" },
    { "action": "store_restock_product", "resource": "*", "effect": "deny" }
  ]
}
